        const today = new Date().toISOString().split('T')[0];
        dateInput.min = today;
        dateInput.value = today;

        // Mobile Menu Toggle logic
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        // Maintenance Mode Toggle Logic
        function toggleMaintenanceMode(forceState = null) {
            const screen = document.getElementById('maintenanceScreen');
            const main = document.getElementById('mainSite');
            const label = document.getElementById('modeStatusLabel');

            const isCurrentlyHidden = screen.classList.contains('hidden');
            const shouldShow = forceState !== null ? forceState : isCurrentlyHidden;

            if (shouldShow) {
                screen.classList.remove('hidden');
                main.classList.add('hidden');
                label.textContent = 'Maintenance';
            } else {
                screen.classList.add('hidden');
                main.classList.remove('hidden');
                label.textContent = 'Live';
            }
        }

        // Open Booking Modal Function
        function openBookingModal(serviceName = null) {
            const modal = document.getElementById('bookingModal');
            const serviceSelect = document.getElementById('serviceSelect');

            if (serviceName) {
                serviceSelect.value = serviceName;
            }

            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.querySelector('.id-modal-box').classList.remove('translate-y-4');
        }

        // Close Booking Modal Function
        function closeBookingModal() {
            const modal = document.getElementById('bookingModal');
            modal.classList.add('opacity-0', 'pointer-events-none');
            modal.querySelector('.id-modal-box').classList.add('translate-y-4');
        }

        // Handle WhatsApp Submission logic
        function handleFormSubmit(e) {
            e.preventDefault();

            const name = document.getElementById('clientName').value;
            const service = document.getElementById('serviceSelect').value;
            const date = document.getElementById('bookingDate').value;
            const time = document.getElementById('bookingTime').value;

            // Format message string
            const rawMessage = `Hi Nails By Valentina! 👋\n\nI would like to book an appointment:\n- *Name:* ${name}\n- *Service:* ${service}\n- *Date:* ${date}\n- *Time Slot:* ${time}\n\nPlease let me know if this slot is available!`;

            // Encode for URL query param
            const encodedMessage = encodeURIComponent(rawMessage);
            const whatsappNumber = '27714512970';
            const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;

            // Close modal & redirect to WhatsApp in a new tab
            closeBookingModal();
            window.open(whatsappUrl, '_blank');
        }
    </script>
